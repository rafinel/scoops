# Local Docker Compose environment
# Copy this file to `.env` before starting the local infrastructure.

# PostgreSQL
POSTGRES_DB=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=54322
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_COOKIE_DOMAIN=

# Authentication and email
SITE_URL=http://localhost:4000
EMAIL_FROM=no-reply@scoops.local
SMTP_HOST=localhost
SMTP_PORT=54325
MAILPIT_SMTP_PORT=54325
MAILPIT_UI_PORT=54324

# Object storage
MINIO_ROOT_USER=scoops
MINIO_ROOT_PASSWORD=scoops-local-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=scoops

# Inngest
INNGEST_PORT=8298
INNGEST_CONNECT_PORT=8299
