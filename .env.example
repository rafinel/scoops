# Local Docker Compose environment
# Copy this file to `.env` before starting the local infrastructure.

# PostgreSQL
POSTGRES_DB=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=54322

# Supabase JWT
# Use a secret with at least 32 characters. ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY must be JWTs signed with this same secret.
JWT_SECRET=scoops-local-jwt-secret-at-least-32-characters
JWT_EXP=3600
ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase API and Studio
SUPABASE_PORT=54321
SUPABASE_PUBLIC_URL=http://127.0.0.1:54321
STUDIO_PORT=54323
STUDIO_DEFAULT_ORGANIZATION=Scoops
STUDIO_DEFAULT_PROJECT=Scoops Local
PG_META_CRYPTO_KEY=scoops-local-pg-meta-key-change-me
PGRST_DB_SCHEMAS=public
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
PGRST_DB_MAX_ROWS=1000
OPENAI_API_KEY=

# Authentication and email
SITE_URL=http://127.0.0.1:4000
AUTH_URI_ALLOW_LIST=http://127.0.0.1:4000
ONBOARDING_CONFIRM_URL=http://127.0.0.1:4000/onboarding/confirm
SMTP_ADMIN_EMAIL=admin@scoops.local
SMTP_SENDER_NAME=Scoops
MAILPIT_SMTP_PORT=54325
MAILPIT_UI_PORT=54324

# Object storage
MINIO_ROOT_USER=scoops
MINIO_ROOT_PASSWORD=scoops-local-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=scoops

# Inngest
INNGEST_PORT=8298
INNGEST_CONNECT_PORT=8299
