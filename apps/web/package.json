{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 4000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "build:vercel": "NITRO_PRESET=vercel vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests --testTimeout=15000",
    "test:integration": "playwright test",
    "test:integration:ui": "playwright test --ui",
    "test:auth:setup": "playwright test --config=playwright.auth.config.ts --workers=1",
    "check:playwright": "node scripts/check-playwright-cli.mjs",
    "check:architecture": "dependency-cruise --config ../../.dependency-cruiser.mjs -- src",
    "format": "biome format --write .",
    "check:code": "biome check src",
    "check:types": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.2.2",
    "@scoops/core": "workspace:*",
    "@scoops/validation": "workspace:^",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-devtools": "0.10.8",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "1.170.16",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-start": "1.168.26",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.85.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "4.3.1",
    "@tanstack/devtools-vite": "0.8.1",
    "@tanstack/router-cli": "1.167.17",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "^28.1.0",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3",
    "vite": "8.1.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
