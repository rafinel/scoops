# Application
SCOOPS_SERVER_APP_MODE=dev
SCOOPS_SERVER_APP_PORT=3336
# Vercel provides PORT automatically. Leave unset for local development.
# PORT=3336
SCOOPS_WEB_APP_URL=http://localhost:4000
SCOOPS_PDV_PREVIEW_TOKEN_SECRET=

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Local services
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_COOKIE_DOMAIN=
EMAIL_FROM=no-reply@scoops.local
SMTP_HOST=localhost
SMTP_PORT=54325
S3_ENDPOINT=http://localhost:9000

# Inngest
# Use INNGEST_DEV=1 with the local development server. In production, remove
# INNGEST_DEV and provide the keys issued by Inngest.
INNGEST_DEV=1
INNGEST_BASE_URL=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
