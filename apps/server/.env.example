# Application
SCOOPS_SERVER_APP_MODE=dev
SCOOPS_SERVER_APP_PORT=3333
# Vercel provides PORT automatically. Leave unset for local development.
# PORT=3333
SCOOPS_WEB_APP_URL=http://127.0.0.1:3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Local services
SUPABASE_URL=http://127.0.0.1:54321
# Browser-safe Supabase anon key used only to verify access tokens.
SUPABASE_ANON_KEY=
# Seed-only admin key. Required by db:seed to reset the fixed dev/staging users.
SUPABASE_SERVICE_ROLE_KEY=
S3_ENDPOINT=http://127.0.0.1:9000

# Inngest
# Use INNGEST_DEV=1 with the local development server. In production, remove
# INNGEST_DEV and provide the keys issued by Inngest.
INNGEST_DEV=1
INNGEST_BASE_URL=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
