@productId = 00000000-0000-0000-0000-000000000000
@brandId = 00000000-0000-0000-0000-000000000000
@linkId = 00000000-0000-0000-0000-000000000000
@accompanimentTypeId = 00000000-0000-0000-0000-000000000000
@accompanimentProductId = 00000000-0000-0000-0000-000000000000
@sizeId = 00000000-0000-0000-0000-000000000000

### List products
GET {{baseUrl}}/products?page=1&pageSize=10&category=ingredient&category=resale
Authorization: Bearer {{accessToken}}
Accept: application/json

### Register a single-stock product
POST {{baseUrl}}/products
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Leite integral",
  "unit": "l",
  "categories": ["ingredient"],
  "stockControl": "single",
  "idealStock": 10
}

### Register a by-brand product
POST {{baseUrl}}/products
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Cobertura de chocolate",
  "unit": "kg",
  "categories": ["ingredient"],
  "stockControl": "by-brand"
}

### Get product stock details
GET {{baseUrl}}/products/{{productId}}/stock
Authorization: Bearer {{accessToken}}
Accept: application/json

### Register a product brand
POST {{baseUrl}}/products/{{productId}}/brands
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Marca exemplo",
  "packageQuantity": 2.5,
  "packageValue": 18.9,
  "initialQuantity": 5
}

### Update a product brand
PATCH {{baseUrl}}/products/{{productId}}/brands/{{brandId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Marca atualizada",
  "packageQuantity": 3,
  "packageValue": 21.5
}

### Set the primary product brand
PATCH {{baseUrl}}/products/{{productId}}/brands/{{brandId}}/primary
Authorization: Bearer {{accessToken}}
Accept: application/json

### Remove a product brand
DELETE {{baseUrl}}/products/{{productId}}/brands/{{brandId}}
Authorization: Bearer {{accessToken}}

### Adjust single-product stock
POST {{baseUrl}}/products/{{productId}}/stock-adjustments
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "type": "entry",
  "quantity": 2.5
}

### Adjust product-brand stock
POST {{baseUrl}}/products/{{productId}}/stock-adjustments
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "brandId": "{{brandId}}",
  "type": "write-off",
  "quantity": 1
}

### List product stock transactions
GET {{baseUrl}}/products/{{productId}}/stock-transactions?type=entry&brandId={{brandId}}&from=2026-08-01T00:00:00.000Z&to=2026-08-31T23:59:59.999Z&page=1&limit=20
Authorization: Bearer {{accessToken}}
Accept: application/json

### Get product accompaniments
GET {{baseUrl}}/products/{{productId}}/accompaniments
Authorization: Bearer {{accessToken}}
Accept: application/json

### Link a product accompaniment
POST {{baseUrl}}/products/{{productId}}/accompaniments
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "accompanimentProductId": "{{accompanimentProductId}}",
  "accompanimentTypeId": "{{accompanimentTypeId}}",
  "quantityPerPortion": 1.25
}

### Update a product accompaniment
PATCH {{baseUrl}}/products/{{productId}}/accompaniments/{{linkId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "accompanimentTypeId": "{{accompanimentTypeId}}",
  "quantityPerPortion": 1.5
}

### Remove a product accompaniment
DELETE {{baseUrl}}/products/{{productId}}/accompaniments/{{linkId}}
Authorization: Bearer {{accessToken}}

### Get product pricing
GET {{baseUrl}}/products/{{productId}}/pricing
Authorization: Bearer {{accessToken}}
Accept: application/json

### Register a Portion size
POST {{baseUrl}}/products/{{productId}}/sizes
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Pote 500 ml",
  "quantity": 0.5,
  "price": 18.9
}

### Update a Portion size
PATCH {{baseUrl}}/products/{{productId}}/sizes/{{sizeId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Pote 500 ml atualizado",
  "quantity": 0.5,
  "price": 19.9,
  "isActive": true
}

### Remove a Portion size
DELETE {{baseUrl}}/products/{{productId}}/sizes/{{sizeId}}
Authorization: Bearer {{accessToken}}

### Save Single resale configuration
PUT {{baseUrl}}/products/{{productId}}/resale-configuration
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "price": 12.5,
  "isActive": true
}

### Save By-brand resale configuration
PUT {{baseUrl}}/products/{{productId}}/brands/{{brandId}}/resale-configuration
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "price": 14.9,
  "isActive": true
}
