@baseUrl = http://localhost:3336
@sessionCookie = replace-with-scoops-session-cookie
@productId = 00000000-0000-0000-0000-000000000000
@brandId = 00000000-0000-0000-0000-000000000000
@linkId = 00000000-0000-0000-0000-000000000000
@accompanimentTypeId = 00000000-0000-0000-0000-000000000000
@accompanimentProductId = 00000000-0000-0000-0000-000000000000
@sizeId = 00000000-0000-0000-0000-000000000000
@lineId = 00000000-0000-0000-0000-000000000000
@expectedUpdatedAt = 2026-08-24T12:00:00.000Z

### List products
GET {{baseUrl}}/products?page=1&pageSize=10&category=ingredient&category=resale&usedAsAccompanimentId={{productId}}
Cookie: {{sessionCookie}}
Accept: application/json

### Get product settings
GET {{baseUrl}}/products/{{productId}}/settings
Cookie: {{sessionCookie}}
Accept: application/json

### Update product settings
PATCH {{baseUrl}}/products/{{productId}}/settings
Cookie: {{sessionCookie}}
Content-Type: application/json

{
  "idealStock": null,
  "internalNotes": "Atualizado pelo gestor",
  "expectedUpdatedAt": "{{expectedUpdatedAt}}"
}

### Preview category removal dependencies
GET {{baseUrl}}/products/{{productId}}/category-removal-impact?category=ingredient
Cookie: {{sessionCookie}}
Accept: application/json

### Change product categories
PATCH {{baseUrl}}/products/{{productId}}/categories
Cookie: {{sessionCookie}}
Content-Type: application/json

{
  "categories": ["ingredient", "manufacturable"],
  "expectedUpdatedAt": "{{expectedUpdatedAt}}"
}

### Preview product unit change
POST {{baseUrl}}/products/{{productId}}/unit-change-preview
Cookie: {{sessionCookie}}
Content-Type: application/json

{
  "targetUnit": "g"
}

### Change product unit
PATCH {{baseUrl}}/products/{{productId}}/unit
Cookie: {{sessionCookie}}
Content-Type: application/json

{
  "targetUnit": "g",
  "expectedUpdatedAt": "{{expectedUpdatedAt}}"
}

### Get product removal impact
GET {{baseUrl}}/products/{{productId}}/removal-impact
Cookie: {{sessionCookie}}
Accept: application/json

### Remove product
DELETE {{baseUrl}}/products/{{productId}}
Cookie: {{sessionCookie}}

### Register a Single-stock product without brands
POST {{baseUrl}}/products
Cookie: {{sessionCookie}}
Content-Type: application/json

{
  "name": "Leite integral",
  "unit": "l",
  "categories": ["ingredient"],
  "stockControl": "single",
  "initialStock": 10,
  "idealStock": 20,
  "currentUnitCost": 4.5
}

### Register a By-brand product with explicit primary brand selection
POST {{baseUrl}}/products
Cookie: {{sessionCookie}}
Content-Type: application/json

{
  "name": "Cobertura de chocolate",
  "unit": "kg",
  "categories": ["ingredient"],
  "stockControl": "by-brand",
  "idealStock": 10,
  "initialStock": 5,
  "brands": [
    {
      "name": "Callebaut",
      "packageQuantity": 2,
      "packageValue": 30,
      "initialQuantity": 5,
      "isPrimary": true
    }
  ]
}

### Get product stock details
GET {{baseUrl}}/products/{{productId}}/stock
Cookie: {{sessionCookie}}
Accept: application/json

### Register a product brand
POST {{baseUrl}}/products/{{productId}}/brands
Cookie: {{sessionCookie}}
Content-Type: application/json

{
  "name": "Marca exemplo",
  "packageQuantity": 2.5,
  "packageValue": 18.9,
  "initialQuantity": 5
}

### Update a product brand
PATCH {{baseUrl}}/products/{{productId}}/brands/{{brandId}}
Cookie: {{sessionCookie}}
Content-Type: application/json

{
  "name": "Marca atualizada",
  "packageQuantity": 3,
  "packageValue": 21.5
}

### Set the primary product brand
PATCH {{baseUrl}}/products/{{productId}}/brands/{{brandId}}/primary
Cookie: {{sessionCookie}}
Accept: application/json

### Remove a product brand
DELETE {{baseUrl}}/products/{{productId}}/brands/{{brandId}}
Cookie: {{sessionCookie}}

### Adjust a Single-stock product without a brand
POST {{baseUrl}}/products/{{productId}}/stock-adjustments
Cookie: {{sessionCookie}}
Content-Type: application/json

{
  "type": "entry",
  "quantity": 2.5,
  "currentUnitCost": 4.75,
  "justification": "Conferência de inventário"
}

### Adjust a By-brand product with a brand
POST {{baseUrl}}/products/{{productId}}/stock-adjustments
Cookie: {{sessionCookie}}
Content-Type: application/json

{
  "brandId": "{{brandId}}",
  "type": "entry",
  "quantity": 2.5,
  "justification": "Conferência de inventário"
}

### List product stock transactions
GET {{baseUrl}}/products/{{productId}}/stock-transactions?type=entry&brandId={{brandId}}&from=2026-08-01T00:00:00.000Z&to=2026-08-31T23:59:59.999Z&page=1&limit=20
Cookie: {{sessionCookie}}
Accept: application/json

