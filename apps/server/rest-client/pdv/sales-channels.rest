@baseUrl = http://localhost:3336
@sessionCookie = replace-with-scoops-session-cookie
@salesChannelId = 00000000-0000-0000-0000-000000000000

### List sales channels (Manager)
GET {{baseUrl}}/sales-channels
Cookie: {{sessionCookie}}
Accept: application/json

### List active sales channels (Manager or Operator)
GET {{baseUrl}}/sales-channels/active
Cookie: {{sessionCookie}}
Accept: application/json

### Create sales channel
POST {{baseUrl}}/sales-channels
Cookie: {{sessionCookie}}
Content-Type: application/json

{
  "name": "Delivery próprio",
  "percentage": 12.5,
  "status": "active"
}

### Update sales channel
PATCH {{baseUrl}}/sales-channels/{{salesChannelId}}
Cookie: {{sessionCookie}}
Content-Type: application/json

{
  "name": "Delivery próprio atualizado",
  "percentage": -5.25
}

### Inactivate sales channel
PATCH {{baseUrl}}/sales-channels/{{salesChannelId}}/inactivate
Cookie: {{sessionCookie}}
Accept: application/json

### Reactivate sales channel
PATCH {{baseUrl}}/sales-channels/{{salesChannelId}}/reactivate
Cookie: {{sessionCookie}}
Accept: application/json

### Delete sales channel
DELETE {{baseUrl}}/sales-channels/{{salesChannelId}}
Cookie: {{sessionCookie}}
Accept: application/json
