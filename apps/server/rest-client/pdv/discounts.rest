@baseUrl = http://localhost:3336
@sessionCookie = replace-with-scoops-session-cookie
@comboId = 00000000-0000-0000-0000-000000000000
@portionProductId = 00000000-0000-0000-0000-000000000000
@portionSizeId = 00000000-0000-0000-0000-000000000000
@accompanimentLinkId = 00000000-0000-0000-0000-000000000000
@resaleProductId = 00000000-0000-0000-0000-000000000000
@resaleBrandId = 00000000-0000-0000-0000-000000000000
@expectedUpdatedAt = 2026-08-24T12:00:00.000Z

### List Combos
GET {{baseUrl}}/discounts?page=1&pageSize=10&type=combo&status=active
Cookie: {{sessionCookie}}
Accept: application/json

### Search and filter Combos by current product
GET {{baseUrl}}/discounts?search=chocolate&type=combo&status=inactive&page=1&pageSize=10
Cookie: {{sessionCookie}}
Accept: application/json

### List sellable products for a Combo, hiding unavailable ones (200)
GET {{baseUrl}}/discounts/catalog?page=1&pageSize=10
Cookie: {{sessionCookie}}
Accept: application/json

# Without a search (or with a whitespace-only one), only products whose
# availability is "available" are returned, and total counts only those.
# Response body:
# {
#   "items": [{
#     "productId": "{{resaleProductId}}",
#     "name": "Chocolate",
#     "kind": "resale",
#     "stockControl": "single",
#     "isActive": true,
#     "isAvailable": true,
#     "availability": "available",
#     "sizes": [],
#     "resalePrice": 12.5,
#     "resaleBrands": []
#   }],
#   "page": 1,
#   "pageSize": 10,
#   "total": 1,
#   "totalPages": 1
# }

### List Portion products available for a Combo
GET {{baseUrl}}/discounts/catalog?kind=portion&page=1&pageSize=10
Cookie: {{sessionCookie}}
Accept: application/json

### Search Combo products by name, revealing unavailable ones (200)
GET {{baseUrl}}/discounts/catalog?search=chocolate&page=1&pageSize=10
Cookie: {{sessionCookie}}
Accept: application/json

# A non-empty trimmed search returns Portion and Resale matches in every availability,
# ordered by name then id. isAvailable is true only when availability is "available".
# Response body:
# {
#   "items": [
#     { "productId": "{{resaleProductId}}", "name": "Chocolate", "kind": "resale", "isAvailable": true, "availability": "available", "sizes": [], "resaleBrands": [] },
#     { "productId": "{{portionProductId}}", "name": "Chocolate sem preco", "kind": "portion", "isAvailable": false, "availability": "missing_price", "sizes": [], "resaleBrands": [] }
#   ],
#   "page": 1,
#   "pageSize": 10,
#   "total": 2,
#   "totalPages": 1
# }

### Search Resale products for a Combo, revealing unavailable ones (200)
GET {{baseUrl}}/discounts/catalog?kind=resale&search=chocolate&page=1&pageSize=10
Cookie: {{sessionCookie}}
Accept: application/json

### Get Combo details
GET {{baseUrl}}/discounts/{{comboId}}
Cookie: {{sessionCookie}}
Accept: application/json

### Create an active Combo with Portion and Resale components
POST {{baseUrl}}/discounts
Cookie: {{sessionCookie}}
Content-Type: application/json

{
  "name": "Combo chocolate",
  "status": "active",
  "fixedPrice": 25.5,
  "components": [
    {
      "kind": "portion",
      "productId": "{{portionProductId}}",
      "quantity": 1,
      "sizeId": "{{portionSizeId}}",
      "accompanimentIds": ["{{accompanimentLinkId}}"]
    },
    {
      "kind": "resale",
      "productId": "{{resaleProductId}}",
      "quantity": 1,
      "brandId": "{{resaleBrandId}}"
    }
  ]
}

### Update a Combo
PATCH {{baseUrl}}/discounts/{{comboId}}
Cookie: {{sessionCookie}}
Content-Type: application/json

{
  "name": "Combo chocolate atualizado",
  "fixedPrice": 24.9,
  "expectedUpdatedAt": "{{expectedUpdatedAt}}",
  "components": [
    {
      "kind": "portion",
      "productId": "{{portionProductId}}",
      "quantity": 1,
      "sizeId": "{{portionSizeId}}",
      "accompanimentIds": []
    },
    {
      "kind": "resale",
      "productId": "{{resaleProductId}}",
      "quantity": 1,
      "brandId": "{{resaleBrandId}}"
    }
  ]
}

### Inactivate a Combo
PATCH {{baseUrl}}/discounts/{{comboId}}/inactivate
Cookie: {{sessionCookie}}
Content-Type: application/json

{
  "expectedUpdatedAt": "{{expectedUpdatedAt}}"
}

### Reactivate a Combo
PATCH {{baseUrl}}/discounts/{{comboId}}/reactivate
Cookie: {{sessionCookie}}
Content-Type: application/json

{
  "expectedUpdatedAt": "{{expectedUpdatedAt}}"
}

### Delete a Combo
DELETE {{baseUrl}}/discounts/{{comboId}}?expectedUpdatedAt={{expectedUpdatedAt}}
Cookie: {{sessionCookie}}
Accept: application/json
