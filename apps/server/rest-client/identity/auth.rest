@supabaseAnonKey = {{$processEnv SUPABASE_ANON_KEY}}

### Sign in with the seeded Manager account
POST {{supabaseUrl}}/auth/v1/token?grant_type=password
apikey: {{supabaseAnonKey}}
Content-Type: application/json

{
  "email": "{{seedEmail}}",
  "password": "{{seedPassword}}"
}

### Get the authenticated local account
GET {{baseUrl}}/auth/session
Authorization: Bearer {{signIn.response.body.$.access_token}}
Accept: application/json

### Change the authenticated user's own name
PATCH {{baseUrl}}/auth/session/name
Authorization: Bearer {{signIn.response.body.$.access_token}}
Content-Type: application/json

{
  "name": "Scoops Manager"
}
