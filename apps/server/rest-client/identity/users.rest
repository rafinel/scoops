@baseUrl = http://localhost:3336
@sessionCookie = replace-with-scoops-session-cookie
@userId = 00000000-0000-0000-0000-000000000000

### List users
GET {{baseUrl}}/users?page=1&pageSize=20
Cookie: {{sessionCookie}}
Accept: application/json

### Get user details
GET {{baseUrl}}/users/{{userId}}
Cookie: {{sessionCookie}}
Accept: application/json

### Invite a user
POST {{baseUrl}}/users/invitations
Cookie: {{sessionCookie}}
Content-Type: application/json

{
  "name": "Maria Operator",
  "email": "maria@example.com",
  "profile": "operator"
}

### Correct a pending invitation
PATCH {{baseUrl}}/users/{{userId}}/invitation
Cookie: {{sessionCookie}}
Content-Type: application/json

{
  "name": "Maria Updated",
  "email": "maria.updated@example.com",
  "profile": "operator"
}

### Resend a pending invitation
POST {{baseUrl}}/users/{{userId}}/invitation/resend
Cookie: {{sessionCookie}}

### Cancel a pending invitation
DELETE {{baseUrl}}/users/{{userId}}/invitation
Cookie: {{sessionCookie}}

### Change a profile
PATCH {{baseUrl}}/users/{{userId}}/profile
Cookie: {{sessionCookie}}
Content-Type: application/json

{
  "profile": "manager"
}

### Change a status
PATCH {{baseUrl}}/users/{{userId}}/status
Cookie: {{sessionCookie}}
Content-Type: application/json

{
  "status": "inactive"
}

### Correct a user name
PATCH {{baseUrl}}/users/{{userId}}/name
Cookie: {{sessionCookie}}
Content-Type: application/json

{
  "name": "Maria Corrected"
}

### Change another user's profile
PATCH {{baseUrl}}/users/{{userId}}/profile
Cookie: {{sessionCookie}}
Content-Type: application/json

{
  "profile": "operator"
}
