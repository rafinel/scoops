@baseUrl = http://localhost:3336
@sessionCookie = replace-with-scoops-session-cookie

### Get current establishment settings
GET {{baseUrl}}/establishments/current
Cookie: {{sessionCookie}}
Accept: application/json

### Change current establishment name
PATCH {{baseUrl}}/establishments/current/name
Cookie: {{sessionCookie}}
Content-Type: application/json

{
  "name": "Scoops Centro"
}
### Change establishment timezone
PATCH {{baseUrl}}/establishments/current/timezone
Content-Type: application/json
Cookie: {{sessionCookie}}

{
  "timeZone": "America/Sao_Paulo"
}

### Change current establishment timezone (invalid value)
PATCH {{baseUrl}}/establishments/current/timezone
Content-Type: application/json
Cookie: {{sessionCookie}}

{
  "timeZone": "Europe/Lisbon"
}
