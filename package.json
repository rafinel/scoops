{
  "name": "my-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "sync:commands": "node scripts/sync-commands.mjs",
    "sync:agents": "node scripts/sync-agents.mjs",
    "sync": "pnpm sync:commands && pnpm sync:agents",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "check:test-integrity": "node scripts/check-test-integrity.mjs",
    "test:coverage": "pnpm --filter @scoops/core test:coverage && pnpm --filter server test:coverage && pnpm --filter web test:coverage",
    "check:architecture": "pnpm --filter @scoops/core check:architecture && pnpm --filter @scoops/validation check:architecture && pnpm --filter server check:architecture && pnpm --filter web check:architecture",
    "check:spec-implementation": "node scripts/check-spec-implementation.mjs",
    "check-types": "turbo run check-types",
    "check:code": "biome check src",
    "check:types": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "dependency-cruiser": "16.10.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
