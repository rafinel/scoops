{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "isolatedModules": true,
    "declaration": true,
    "jsx": "react-jsx",
    "target": "ES2023",
    "outDir": "./dist",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "lib": ["ES2023", "DOM"]
  },
  "include": ["templates/**/*.tsx"],
  "exclude": ["node_modules", "build"]
}
