  "exports": {
    "./templates": "./templates/index.ts"
  },
  "dependencies": {
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.5",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "react-email": "6.9.5",
    "typescript": "5.9.2"
  }
}
