    "#mrp/*": "./src/mrp/*",
    "#pdv/*": "./src/pdv/*",
    "#shared/*": "./src/shared/*"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@vitest/coverage-v8": "4.1.10",
    "vitest": "^4.1.10",
    "vitest-mock-extended": "^5.1.1"
